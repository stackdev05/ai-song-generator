# Story Chord Environment Variables
# Copy this file to .env.local and fill in your actual API keys

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# TopMediaAI API Configuration
# Get your API key from: https://api.topmediai.com
# Used for song generation and lyrics generation
TOPMEDIA_API_KEY=your_topmedia_api_key_here

# Stripe Configuration
# Get your API keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLIC_KEY=your_stripe_publick_key_here


# Public base URL of the app (used for redirect fallbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Song Pricing Configuration
# Price in cents (e.g., 299 = $2.99, 999 = $9.99)
# This is public since it's displayed in the UI
NEXT_PUBLIC_SONG_PRICE_CENTS=299
