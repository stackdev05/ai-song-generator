# Story Chord Environment Variables
# Copy this file to .env.local and fill in your actual API keys

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# TopMediaAI API Configuration
# Get your API key from: https://api.topmediai.com
# Used for song generation and lyrics generation
TOPMEDIA_API_KEY=your_topmedia_api_key_here
